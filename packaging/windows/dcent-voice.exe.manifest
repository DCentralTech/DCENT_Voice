<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="0.2.0.1" name="DCENT_Voice.App"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!--
    Windows only defines supportedOS GUIDs down to a major release, not a build,
    so the {8e0f...} "Windows 10 and 11" entry is the finest grain available.
    The *supported* floor is narrower than what this list declares: Windows 10
    version 1809 (build 17763), enforced by
    packaging/windows/setup-stub/Program.cs (MinimumWindowsBuild). Below that,
    hold-to-talk dictation would run but the Settings window, the overlay and the
    setup wizard cannot: they are pywebview on pythonnet, which needs .NET
    Framework 4.7.2 — preinstalled from 1803/1809 onward. The pre-Windows-10
    entries below stay only so the manifest keeps declaring an unbroken lineage
    to the shell; they are not a support claim. Keep in step with README.md,
    docs/PACKAGING.md and docs/QA_FRESH_MACHINE.md.
  -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 (supported from build 17763 / 1809 up). -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 — declared for shell lineage only; not supported. -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 — declared for shell lineage only; not supported. -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 — declared for shell lineage only; not supported. -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- Windows Vista — declared for shell lineage only; not supported. -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
