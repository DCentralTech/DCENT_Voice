      "must_not_contain": ["press enter"]
    },
    {
      "id": "press-enter-alone-empty",
      "kind": "compose",
      "style": "plain",
      "input": "press enter",
      "exact": ""
    },
    {
      "id": "press-enter-content-kept",
      "kind": "compose",
      "style": "plain",
      "input": "press enter to continue",
      "must_contain": ["Press enter to continue."],
      "must_not_contain": ["ship"]
    }
  ]
}
