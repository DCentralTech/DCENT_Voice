      "must_contain": ["https://cal.example/me"],
      "must_not_contain": ["my calendar"]
    },
    {
      "id": "filled-my-signature-expands",
      "kind": "compose",
      "style": "plain",
      "snippets": [{"spoken": "my signature", "expansion": "Best regards,"}],
      "input": "thanks my signature",
